#!/usr/bin/env python3
"""Render a dashboard frame to PNG, for docs.

    aulora tui --demo --snapshot 150x40 --theme catppuccin --json > frame.jsonl
    tools/render-screenshot frame.jsonl docs/screenshots/overview.png 1e1e2e

The last argument is the terminal background to assume, as hex. Needs
Pillow and the macOS fonts Menlo, Apple Braille and Apple Symbols.
"""
import json, sys
from PIL import Image, ImageDraw, ImageFont
rows = [json.loads(l) for l in open(sys.argv[1]) if l.strip()]
term_bg = tuple(int(sys.argv[3][i:i+2], 16) for i in (0, 2, 4)) if len(sys.argv) > 3 else (30, 30, 46)
term_fg = (205, 214, 244) if sum(term_bg) < 384 else (60, 60, 70)
ansi = [(0,0,0),(205,49,49),(13,188,121),(229,229,16),(36,114,200),(188,63,188),(17,168,205),(229,229,229),(102,102,102),(241,76,76),(35,209,139),(245,245,67),(59,142,234),(214,112,214),(41,184,219),(255,255,255)]
def idx(i):
    if i < 16: return ansi[i]
    if i < 232:
        i -= 16; c = [0, 95, 135, 175, 215, 255]; return (c[i // 36], c[(i // 6) % 6], c[i % 6])
    v = 8 + (i - 232) * 10; return (v, v, v)
def col(c, default): return default if c is None else (tuple(c) if isinstance(c, list) else idx(c))
font = ImageFont.truetype("/System/Library/Fonts/Menlo.ttc", 26); bold = ImageFont.truetype("/System/Library/Fonts/Menlo.ttc", 26, index=1)
braille = ImageFont.truetype("/System/Library/Fonts/Apple Braille.ttf", 28)
symbols = ImageFont.truetype("/System/Library/Fonts/Apple Symbols.ttf", 26)
# Glyphs none of the fonts have, drawn as the nearest one they do.
MISSING = {"⏵": "▸"}
cw, ch = 16, 32
img = Image.new("RGB", (len(rows[0]) * cw, len(rows) * ch), term_bg); d = ImageDraw.Draw(img)
for y, row in enumerate(rows):
    for x, (sym, fg, bg, b) in enumerate(row):
        bgc = col(bg, term_bg)
        if bgc != term_bg: d.rectangle([x*cw, y*ch, (x+1)*cw, (y+1)*ch], fill=bgc)
        sym = MISSING.get(sym, sym)
        if sym and sym != " ":
            o = ord(sym[0])
            f = braille if 0x2800 <= o <= 0x28FF else (symbols if (0x2190 <= o <= 0x23FF and o not in (0x2190, 0x2191, 0x2192, 0x2193)) else (bold if b else font))
            d.text((x*cw, y*ch + 2), sym, font=f, fill=col(fg, term_fg))
img = img.resize((img.width // 2, img.height // 2), Image.LANCZOS); img.save(sys.argv[2]); print(sys.argv[2], img.size)

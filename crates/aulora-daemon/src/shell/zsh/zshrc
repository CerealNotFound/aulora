# aulora's shell integration: load your .zshrc, then say when each
# command starts and how it ended (OSC 133, as VS Code and iTerm2 do),
# so aulora can show a dev server that exited.
__aulora_user_zdotdir
unfunction __aulora_save_zdotdir __aulora_user_zdotdir
# /etc/zshrc ran with ZDOTDIR pointing here; keep your history file.
if [[ ${HISTFILE-} == ${AULORA_ZDOTDIR-}/* ]]; then
  HISTFILE=${ZDOTDIR:-$HOME}/.zsh_history
fi
[[ -r ${ZDOTDIR:-$HOME}/.zshrc ]] && builtin source "${ZDOTDIR:-$HOME}/.zshrc"

typeset -g __aulora_ran=
__aulora_precmd() {
  local code=$?
  if [[ -n $__aulora_ran ]]; then
    __aulora_ran=
    builtin printf '\e]133;D;%s\a' $code
  fi
  __aulora_jobs
  builtin printf '\e]133;A\a'
}

# Jobs: say how many run in the background (&) and how many are paused
# (Ctrl-Z), and how each one ended. zsh has a job's status a moment
# after it ends, so that's looked up a second later.
zmodload zsh/sched zsh/parameter 2>/dev/null
typeset -gA __aulora_job_pids
typeset -g __aulora_check_due=
__aulora_jobs() {
  local job pid running=0 paused=0
  for job in ${(v)jobstates}; do
    case $job in
      running:*) (( running++ )) ;;
      suspended:*) (( paused++ )) ;;
    esac
    for pid in ${(s.:.)job[(ws.:.)3,-1]}; do
      __aulora_job_pids[${pid%%=*}]=1
    done
  done
  builtin printf '\e]aulora;jobs;%d;%d\a' $running $paused
}
__aulora_check_jobs() {
  __aulora_check_due=
  local pid code
  for pid in ${(k)__aulora_job_pids}; do
    if ! builtin kill -0 $pid 2>/dev/null; then
      builtin wait $pid 2>/dev/null
      code=$?
      unset "__aulora_job_pids[$pid]"
      # 127: zsh no longer knows it.
      (( code != 127 )) && builtin printf '\e]aulora;job-ended;%d\a' $code
    fi
  done
  __aulora_jobs
}
(( ${+functions[TRAPCHLD]} )) && functions[__aulora_user_trapchld]=$functions[TRAPCHLD]
TRAPCHLD() {
  if [[ -z $__aulora_check_due ]] && (( ${#__aulora_job_pids} )); then
    __aulora_check_due=1
    sched +1 __aulora_check_jobs
  fi
  if (( ${+functions[__aulora_user_trapchld]} )); then
    __aulora_user_trapchld "$@"
  fi
}
__aulora_preexec() {
  __aulora_ran=1
  builtin printf '\e]133;C\a'
}
typeset -ga precmd_functions preexec_functions
precmd_functions=(__aulora_precmd ${precmd_functions:#__aulora_precmd})
preexec_functions+=(__aulora_preexec)

# A pane started with a command types it at the first prompt, so it's
# in your history and the shell is still there when it ends.
if [[ -n ${AULORA_RUN-} ]]; then
  typeset -g __aulora_run=$AULORA_RUN
  unset AULORA_RUN
  __aulora_run_once() {
    add-zle-hook-widget -d line-init __aulora_run_once
    BUFFER=$__aulora_run
    unset __aulora_run
    zle .accept-line
  }
  autoload -Uz add-zle-hook-widget
  zle -N __aulora_run_once
  add-zle-hook-widget line-init __aulora_run_once
fi
